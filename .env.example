# Salin ke .env lalu isi. Jangan commit .env.
POSTGRES_DB=lactos
POSTGRES_USER=lactos
POSTGRES_PASSWORD=
# php artisan key:generate --show
APP_KEY=
APP_ENV=local
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_PORT=8080
REVERB_PUBLIC_HOST=localhost
ENGINE_INTERNAL_TOKEN=
# LLM Asisten Operator: gemini (bawaan, isi API_KEY) | openai | anthropic | local | mock (demo/tes, tanpa jaringan)
# local = server/router berformat OpenAI (Ollama, LM Studio, vLLM, LiteLLM, OpenRouter): isi BASE_URL.
# Kunci API hanya di file .env ini, jangan di chat atau commit.
ENGINE_LLM_PROVIDER=gemini
ENGINE_LLM_BASE_URL=
ENGINE_LLM_API_KEY=
ENGINE_LLM_MODEL=
# Hanya Gemini: tambahkan ENGINE_LLM_THINKING_BUDGET=0 di engine/.env bila balasan kosong.
ENGINE_LLM_TEMPERATURE=0.2
